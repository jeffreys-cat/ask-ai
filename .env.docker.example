DATABASE_URL=postgres://postgres:postgres@your-postgres-host:5432/ask_ai
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
INIT_USER_EMAIL=admin@example.com
INIT_USER_PASSWORD=change-me-password
INIT_ORGANIZATION_ID=dev-org
# Optional. INIT_USER_NAME defaults to the email prefix; organization name/slug default from INIT_ORGANIZATION_ID.
# INIT_USER_NAME=Admin
# INIT_ORGANIZATION_NAME=Default Organization
# INIT_ORGANIZATION_SLUG=default
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DORIS_HOST=host.docker.internal
DORIS_PORT=9030
DORIS_USER=root
DORIS_PASSWORD=
DORIS_DATABASE=ask_ai
DORIS_CHUNKS_TABLE=document_chunks
DORIS_ENABLE_ANN_INDEX=false

INGEST_SOURCE_STORAGE=local
INGEST_WORKER_POLL_INTERVAL_MS=2000
INGEST_WORKER_LEASE_TIMEOUT_MS=300000
INGEST_WORKER_HEARTBEAT_INTERVAL_MS=15000
INGEST_WORKER_MAX_ATTEMPTS=3

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-change-me
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Optional Litefuse / Mastra observability
# LITEFUSE_PUBLIC_KEY=pk-lf-change-me
# LITEFUSE_SECRET_KEY=sk-lf-change-me
# LITEFUSE_BASE_URL=https://litefuse.cloud
# LITEFUSE_SERVICE_NAME=ask-ai
# LITEFUSE_REALTIME=false
# LITEFUSE_EVAL_DATASET=ask-ai-docs-eval
# LITEFUSE_EVAL_ORGANIZATION_ID=org-dev
# LITEFUSE_EVAL_MAX_CONCURRENCY=2
# LITEFUSE_EVAL_MIN_ITEMS=30
